{
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    // 显式声明 target/lib：代码使用至 ES2019（Object.fromEntries/flatMap）的全局。
    // 不显式声明时 tsc 退到默认 ES5+DOM，编译结果取决于是否恰好有 @types/node 注入
    // ES2015-ES2020（CI 与本地 hoist 行为不同导致 CI 全量失败）。显式声明后环境无关。
    "target": "es2020",
    "lib": ["ES2020", "DOM"],
    "paths": {
      "@/*": ["./src/*"],
      // ts-jest 类型检查不应用 jest moduleNameMapper（纯 TS 解析），
      // 且 @jadezhou/sticky-tab-view 只存在于 example/node_modules 的 symlink。
      // 这两个路径让测试的类型检查不再依赖 dist 产物，环境无关地解析到源码。
      // 构建/typecheck（src 内部用相对导入）不受影响。
      "@jadezhou/sticky-tab-view/scheduleOnReactNative": ["./src/scheduleOnReactNative.ts"],
      "@jadezhou/sticky-tab-view": ["./src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
