# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# Expo example 的 CNG 生成目录（prebuild --clean 后 regenerate）
# 注意：只忽略 example/ 下的生成物；fixtures/rn-081/android|ios 是提交的锚点原生工程，不能忽略。
/example/ios
/example/android
# fixtures/rn-081：原生工程本身是**提交的锚点**（上面的排除不适用于它），
# 但工程目录内的构建产物与本地环境文件必须忽略，否则跑一次本地构建就会
# 在 git status 里堆出一片 untracked。
/fixtures/rn-081/android/.gradle/
/fixtures/rn-081/android/build/
/fixtures/rn-081/android/app/build/
/fixtures/rn-081/android/app/.cxx/
/fixtures/rn-081/android/local.properties
/fixtures/rn-081/ios/Pods/
/fixtures/rn-081/ios/build/
/fixtures/rn-081/ios/Podfile.lock
/fixtures/rn-081/ios/.xcode.env
/fixtures/rn-081/ios/.xcode.env.local
/fixtures/rn-081/ios/*.xcworkspace/
/fixtures/rn-081/ios/*.xcodeproj/xcuserdata/
/fixtures/rn-081/ios/*.xcodeproj/project.xcworkspace/xcuserdata/

# npm (use pnpm)
package-lock.json

# 私有执行记录与内部文档：只暴露目录名，防止新 clone 误提交
/docs_private/