# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'StickyTabViewFixture' do
  config = use_native_modules!

  # pnpm monorepo：reactNativePath 是符号链接路径（<repo>/node_modules/react-native），
  # CocoaPods 对符号链接路径 realdirpath 时，在 macOS arm64 + Ruby 3.3 上会把 pnpm store
  # 段写成 NUL（CocoaPods#12798）。对齐 expo/expo#34203：用 node 的 fs.realpath 解析为真实路径，
  # 让 CocoaPods 全程走真实路径，绕开 Ruby realdirpath 的损坏。
  # 注意：use_react_native! 内部用 File.join(installation_root, path) 拼包路径，绝对路径会被
  # 拼成 ./<abs> 而找不到 package.json，所以必须把 realpath 转成相对 Podfile 目录的相对路径
  # （与 autolinking 生成的 ../node_modules/... 同风格）。
  # 与文件顶部一致用 Pod::Executable.execute_command 执行 node（数组参数，不经 shell）：
  # node 解析失败会抛错 fail-fast，而不是像 backticks 那样静默返回空串回退到符号链接路径
  # （P1-02）；随后仍校验 realpath 目录存在 package.json，失败只告警、保留 autolinked 值。
  __rn_real = Pod::Executable.execute_command('node', ['-p',
    'require("fs").realpathSync(require("path").dirname(require.resolve("react-native", {paths: [process.argv[1]]})))',
    File.dirname(__FILE__)]).strip
  __rn_abs = File.expand_path(__rn_real, File.dirname(__FILE__))
  __rn_pkg = File.join(__rn_abs, 'package.json')
  if File.directory?(__rn_abs) && File.exist?(__rn_pkg)
    config[:reactNativePath] = Pathname.new(__rn_abs).relative_path_from(Pathname.new(File.dirname(__FILE__))).to_s
  else
    Pod::UI.warn "[sticky-tab-view fixture] reactNativePath realpath unusable: #{__rn_abs.inspect}; keeping autolinked path"
  end

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Xcode 26+/27 本地构建所需的两项加固（CI 的 Xcode 16 上无副作用）：
    #
    # 1) 部署目标下限：Xcode 27 拒绝 IPHONEOS_DEPLOYMENT_TARGET 低于 SDK 下限（15.0）的 pod
    #    target，而部分 RN/Expo 依赖仍声明 9.0（实测 SDWebImage）。低于 15.0 的统一抬到 15.1。
    # 2) fmt consteval 回归：fmt 11.0.2 的 format-inl.h 只在 Apple clang < 14 时规避 consteval，
    #    Xcode 26+ / Clang 21+ 下会编译失败。强制 C++17 即令 FMT_USE_CONSTEVAL=0
    #    （example 侧由 plugins/with-fmt-cpp17.js 做同样的事）。
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        current = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        if current.nil? || current.to_f < 15.0
          config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
        end
        if target.name == 'fmt'
          config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
        end
      end
    end
  end
end
